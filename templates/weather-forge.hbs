<form class="weather-forge-form">
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-generator" value="generator" {{#if activeTabs.generator}}checked{{/if}}>
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-forecast" value="forecast" {{#if activeTabs.forecast}}checked{{/if}}>
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-history" value="history" {{#if activeTabs.history}}checked{{/if}}>
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-settings" value="settings" {{#if activeTabs.settings}}checked{{/if}}>

  <nav class="weather-tabs" aria-label="{{labels.tabs_label}}">
    <label class="weather-tab" for="weather-forge-tab-generator">
      <i class="fas fa-cloud-sun-rain"></i> {{labels.tabs_generator}}
    </label>
    <label class="weather-tab" for="weather-forge-tab-forecast">
      <i class="fas fa-chart-line"></i> {{labels.tabs_forecast}}
    </label>
    <label class="weather-tab" for="weather-forge-tab-history">
      <i class="fas fa-book-open"></i> {{labels.tabs_history}}
    </label>
    <label class="weather-tab" for="weather-forge-tab-settings">
      <i class="fas fa-gear"></i> {{labels.tabs_settings}}
    </label>
  </nav>

  <section class="weather-tab-content weather-generator-tab">
    <section class="weather-forge-grid weather-forge-grid-compact">
      <article class="weather-panel current">
        <h2>{{labels.ui_currentWeather}}</h2>
        <div class="weather-card">
          <div class="weather-headline">
            <strong>{{current.timeSegmentLabel}}</strong>
            <span>{{current.seasonLabel}}</span>
          </div>

          <p class="weather-description">{{current.description}}</p>

          <dl class="weather-values">
            <dt>{{labels.field_temperature}}</dt><dd>{{current.temperature}} °C</dd>
            <dt>{{labels.field_dailyMinMax}}</dt><dd>{{current.dailyMinTemp}} / {{current.dailyMaxTemp}} °C</dd>
            <dt>{{labels.field_trend}}</dt><dd>{{current.trendLabel}}</dd>
            <dt>{{labels.field_precipitation}}</dt><dd>{{current.precipitationLabel}}</dd>
            <dt>{{labels.field_humidity}}</dt><dd>{{current.humidity}} % · {{current.humidityDescription}}</dd>
            <dt>{{labels.field_cloudDensity}}</dt><dd>{{current.cloudDensity}} % · {{current.cloudDensityDescription}}</dd>
            <dt>{{labels.field_windStrength}}</dt><dd>{{current.windStrength}} · {{current.windStrengthDescription}}</dd>
            <dt>{{labels.field_weekday}}</dt><dd>{{current.weekdayLabel}}</dd>
            <dt>{{labels.field_dayOfMonth}}</dt><dd>{{current.dayOfMonth}}</dd>
            <dt>{{labels.field_month}}</dt><dd>{{current.monthLabel}}</dd>
            <dt>{{labels.field_year}}</dt><dd>{{current.year}}</dd>
            <dt>{{labels.field_moonPhase}}</dt><dd>{{current.moonPhaseLabel}}</dd>
            <dt>{{labels.field_climateZone}}</dt><dd>{{current.climateZoneLabel}}</dd>
            <dt>{{labels.field_extremeWeather}}</dt><dd>{{current.extremeLabel}}</dd>
          </dl>
        </div>
      </article>

      <article class="weather-panel generation-actions">
        <h2>{{labels.ui_weatherGeneration}}</h2>
        <div class="calendar-summary">
          <strong>{{calendar.weekdayLabel}}, {{calendar.dayOfMonth}}. {{calendar.monthLabel}} {{calendar.year}}</strong><br>
          <span>{{#if calendarIntegration.active}}{{calendar.formattedTime}} · {{/if}}{{calendar.timeSegmentLabel}} · {{calendar.seasonLabel}} · {{calendar.moonPhaseLabel}}</span>
          {{#if calendarIntegration.active}}
            <div class="calendar-source-badge"><i class="fas fa-calendar-days"></i> {{labels.calendarIntegration_active}}</div>
          {{/if}}
        </div>

        {{#if calendarIntegration.active}}
          <div class="daypart-status {{#if calendarIntegration.resolved}}is-resolved{{else}}is-open{{/if}}">
            <strong>{{calendarIntegration.currentSegmentLabel}}</strong>
            <span>{{#if calendarIntegration.resolved}}{{labels.calendarIntegration_currentResolved}}{{else}}{{labels.calendarIntegration_currentOpen}}{{/if}}</span>
          </div>
          <p class="weather-hint">{{labels.calendarIntegration_timeOwned}}</p>
        {{else}}
          <p class="weather-hint">{{labels.ui_settingsMovedHint}}</p>
        {{/if}}

        <div class="weather-actions">
          {{#if calendarIntegration.active}}
            <button type="button" data-action="generate" {{#unless calendarIntegration.canGenerateCurrent}}disabled{{/unless}}><i class="fas fa-dice-d20"></i> {{labels.ui_generate}}</button>
            <button type="button" data-action="accept" {{#unless calendarIntegration.canAcceptCurrent}}disabled{{/unless}}><i class="fas fa-check"></i> {{labels.ui_accept}}</button>
            <button type="button" data-action="prepareNextPreview" {{#unless calendarIntegration.canPrepareNext}}disabled{{/unless}}><i class="fas fa-forward"></i> {{labels.calendarIntegration_prepareNext}}</button>
          {{else}}
            <button type="button" data-action="generate"><i class="fas fa-dice-d20"></i> {{labels.ui_generate}}</button>
            <button type="button" data-action="accept" {{#unless preview}}disabled{{/unless}}><i class="fas fa-check"></i> {{labels.ui_accept}}</button>
          {{/if}}
          <button type="button" data-action="reset"><i class="fas fa-undo"></i> {{labels.ui_reset}}</button>
        </div>

        {{#if calendarIntegration.active}}
          <div class="next-daypart-box">
            <strong>{{labels.calendarIntegration_nextPhase}}:</strong> {{calendarIntegration.nextSegmentLabel}} · {{calendarIntegration.nextTimeLabel}}
            {{#if calendarIntegration.queued}}<div><i class="fas fa-check"></i> {{labels.calendarIntegration_nextPrepared}}</div>{{/if}}
          </div>
        {{/if}}

        <hr>

        <h3>{{labels.chat_publishTitle}}</h3>
        <div class="weather-actions compact two-buttons">
          <button type="button" data-action="publishGM"><i class="fas fa-user-secret"></i> {{labels.chat_publishGM}}</button>
          <button type="button" data-action="publishPublic"><i class="fas fa-users"></i> {{labels.chat_publishPublic}}</button>
        </div>
      </article>

      <article class="weather-panel preview">
        <h2>{{labels.ui_preview}}</h2>
        {{#if previewDisplay}}
          <div class="preview-context {{#if previewIsQueued}}is-queued{{/if}}">
            <i class="fas {{#if previewIsQueued}}fa-forward{{else}}fa-cloud-sun{{/if}}"></i>
            <strong>{{previewContextLabel}}</strong>
          </div>
          <div class="weather-card">
            <div class="weather-headline">
              <strong>{{previewDisplay.timeSegmentLabel}}</strong>
              <span>{{previewDisplay.seasonLabel}}</span>
            </div>
            <p class="weather-description">{{previewDisplay.description}}</p>
            <dl class="weather-values">
              <dt>{{labels.field_temperature}}</dt><dd>{{previewDisplay.temperature}} °C</dd>
              <dt>{{labels.field_dailyMinMax}}</dt><dd>{{previewDisplay.dailyMinTemp}} / {{previewDisplay.dailyMaxTemp}} °C</dd>
              <dt>{{labels.field_trend}}</dt><dd>{{previewDisplay.trendLabel}}</dd>
              <dt>{{labels.field_precipitation}}</dt><dd>{{previewDisplay.precipitationLabel}}</dd>
              <dt>{{labels.field_humidity}}</dt><dd>{{previewDisplay.humidity}} % · {{previewDisplay.humidityDescription}}</dd>
              <dt>{{labels.field_cloudDensity}}</dt><dd>{{previewDisplay.cloudDensity}} % · {{previewDisplay.cloudDensityDescription}}</dd>
              <dt>{{labels.field_windStrength}}</dt><dd>{{previewDisplay.windStrength}} · {{previewDisplay.windStrengthDescription}}</dd>
              <dt>{{labels.field_weekday}}</dt><dd>{{previewDisplay.weekdayLabel}}</dd>
              <dt>{{labels.field_dayOfMonth}}</dt><dd>{{previewDisplay.dayOfMonth}}</dd>
              <dt>{{labels.field_month}}</dt><dd>{{previewDisplay.monthLabel}}</dd>
              <dt>{{labels.field_year}}</dt><dd>{{previewDisplay.year}}</dd>
              <dt>{{labels.field_moonPhase}}</dt><dd>{{previewDisplay.moonPhaseLabel}}</dd>
              <dt>{{labels.field_climateZone}}</dt><dd>{{previewDisplay.climateZoneLabel}}</dd>
              <dt>{{labels.field_extremeWeather}}</dt><dd>{{previewDisplay.extremeLabel}}</dd>
            </dl>
          </div>
          {{#if previewIsQueued}}
            <p class="queued-preview-hint"><i class="fas fa-clock"></i> {{labels.calendarIntegration_queuedHint}}</p>
          {{/if}}
        {{else}}
          <p class="empty-preview">{{previewEmptyLabel}}</p>
        {{/if}}
      </article>
    </section>
  </section>


  <section class="weather-tab-content weather-forecast-tab">
    <section class="weather-history-panel forecast-panel">
      <div class="history-header">
        <div>
          <h2>{{labels.forecast_title}}</h2>
          <p>{{labels.forecast_hint}}</p>
        </div>
        <div class="weather-actions compact two-buttons">
          <button type="button" data-action="generateForecast"><i class="fas fa-wand-magic-sparkles"></i> {{labels.forecast_generate}}</button>
          <button type="button" data-action="publishForecastGM" {{#unless forecast.hasEntries}}disabled{{/unless}}><i class="fas fa-user-secret"></i> {{labels.forecast_publishGM}}</button>
        </div>
      </div>

      {{#if forecast.hasEntries}}
        <div class="forecast-list">
          {{#each forecast.entries}}
            <article class="forecast-card">
              <div class="forecast-card-head">
                <strong>{{weekdayLabel}}, {{calendar.dayOfMonth}}. {{monthLabel}}</strong>
                <span>{{seasonLabel}}</span>
              </div>
              <p class="forecast-main">{{weatherLabel}}</p>
              <dl class="weather-values forecast-values">
                <dt>{{labels.forecast_field_temperatureRange}}</dt><dd>{{temperatureRange}}</dd>
                <dt>{{labels.forecast_field_rainRisk}}</dt><dd>{{rainRiskLabel}}</dd>
                <dt>{{labels.forecast_field_stormRisk}}</dt><dd>{{stormRiskLabel}}</dd>
                <dt>{{labels.forecast_field_confidence}}</dt><dd>{{confidenceLabel}}</dd>
                <dt>{{labels.forecast_field_trend}}</dt><dd>{{trendLabel}}</dd>
                <dt>{{labels.forecast_field_driver}}</dt><dd>{{driverLabel}}</dd>
              </dl>
              <p class="forecast-hint">{{gmHint}}</p>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="empty-preview">{{labels.forecast_empty}}</p>
      {{/if}}
    </section>
  </section>

  <section class="weather-tab-content weather-history-tab">
    <section class="weather-history-panel">
      <div class="history-header">
        <div>
          <h2>{{labels.history_title}}</h2>
          <p>{{labels.history_hint}}</p>
        </div>
        <button type="button" data-action="clearHistory" {{#unless history.hasEntries}}disabled{{/unless}}>
          <i class="fas fa-trash"></i> {{labels.history_clear}}
        </button>
      </div>

      {{#if history.hasEntries}}
        <div class="history-list">
          {{#each history.groups}}
            <details class="history-day" {{#if @first}}open{{/if}}>
              <summary>
                <span class="history-date">{{#if displayDate}}{{displayDate}}{{else}}{{weekdayLabel}}, {{dayOfMonth}}. {{monthLabel}} {{year}}{{/if}}</span>
                <span class="history-summary">{{summary}}</span>
              </summary>

              <div class="history-entries">
                {{#each entries}}
                  <article class="history-entry">
                    <div class="history-entry-head">
                      <strong>{{timeSegmentLabel}}</strong>
                      <span>{{temperature}} °C · {{precipitationLabel}}</span>
                    </div>
                    <p class="history-entry-description">{{description}}</p>
                    <dl class="history-entry-values">
                      <dt>{{labels.field_dailyMinMax}}</dt><dd>{{dailyMinTemp}} / {{dailyMaxTemp}} °C</dd>
                      <dt>{{labels.field_humidity}}</dt><dd>{{humidityText}}</dd>
                      <dt>{{labels.field_cloudDensity}}</dt><dd>{{cloudDensityText}}</dd>
                      <dt>{{labels.field_windStrength}}</dt><dd>{{windStrengthText}}</dd>
                      <dt>{{labels.field_trend}}</dt><dd>{{trendLabel}}</dd>
                      <dt>{{labels.field_extremeWeather}}</dt><dd>{{extremeLabel}}</dd>
                    </dl>
                  </article>
                {{/each}}
              </div>
            </details>
          {{/each}}
        </div>
      {{else}}
        <p class="empty-preview">{{labels.history_empty}}</p>
      {{/if}}
    </section>
  </section>

  <section class="weather-tab-content weather-settings-tab">
    <section class="settings-tab-grid">
      <article class="weather-panel settings-section">
        <h2>{{labels.settingsTab_climateTitle}}</h2>
        <div class="form-group">
          <label>{{labels.ui_climateZone}}</label>
          <select name="climateZone">
            {{#each climateZones}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <label class="checkbox-row">
          <input type="checkbox" name="allowExtreme" {{#if appSettings.allowExtreme}}checked{{/if}}>
          <span>{{labels.ui_allowExtreme}}</span>
        </label>

        <div class="form-group">
          <label>{{labels.settings_extremeFrequency}}</label>
          <select name="extremeFrequency">
            {{#each appSettings.extremeFrequencies}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <label class="checkbox-row">
          <input type="checkbox" name="forceExtreme">
          <span>{{labels.ui_forceExtreme}}</span>
        </label>

        <div class="form-group">
          <label>{{labels.ui_extremeType}}</label>
          <select name="extremeType">
            {{#each extremeTypes}}
              <option value="{{key}}">{{label}}</option>
            {{/each}}
          </select>
        </div>
      </article>

      <article class="weather-panel settings-section">
        <h2>{{labels.settingsTab_calendarTitle}}</h2>

        <div class="form-group">
          <label>{{labels.calendarIntegration_source}}</label>
          <select name="calendarSourceMode">
            {{#each appSettings.calendarSourceModes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>

        {{#unless appSettings.calendarForgeAvailable}}
          <p class="weather-hint"><i class="fas fa-rotate-left"></i> {{labels.calendarIntegration_fallback}}</p>
        {{/unless}}

        {{#if appSettings.calendarForgeAvailable}}
          <div class="calendar-grid">
            <div class="form-group">
              <label>{{labels.calendarIntegration_region}}</label>
              <select name="calendarForgeRegionId">
                {{#each appSettings.calendarForgeRegions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
            <div class="form-group">
              <label>{{labels.calendarIntegration_moon}}</label>
              <select name="calendarForgeMoonId">
                {{#each appSettings.calendarForgeMoons}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>{{labels.calendarIntegration_mode}}</label>
            <select name="daypartAutomationMode">
              {{#each appSettings.daypartAutomationModes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>

          <h3>{{labels.calendarIntegration_dayparts}}</h3>
          <div class="daypart-boundary-grid">
            <label>{{labels.time_morning}} <input type="number" name="daypartMorning" min="0" max="23" value="{{appSettings.daypartBoundaries.morning}}"></label>
            <label>{{labels.time_noon}} <input type="number" name="daypartNoon" min="0" max="23" value="{{appSettings.daypartBoundaries.noon}}"></label>
            <label>{{labels.time_afternoon}} <input type="number" name="daypartAfternoon" min="0" max="23" value="{{appSettings.daypartBoundaries.afternoon}}"></label>
            <label>{{labels.time_evening}} <input type="number" name="daypartEvening" min="0" max="23" value="{{appSettings.daypartBoundaries.evening}}"></label>
            <label>{{labels.time_night}} <input type="number" name="daypartNight" min="0" max="23" value="{{appSettings.daypartBoundaries.night}}"></label>
          </div>
        {{/if}}

        <div class="calendar-summary">
          <strong>{{calendar.weekdayLabel}}, {{calendar.dayOfMonth}}. {{calendar.monthLabel}} {{calendar.year}}</strong><br>
          <span>{{#if calendarIntegration.active}}{{calendar.formattedTime}} · {{/if}}{{calendar.timeSegmentLabel}} · {{calendar.seasonLabel}} · {{calendar.moonPhaseLabel}}</span>
        </div>

        {{#if calendarIntegration.active}}
          <p class="weather-hint"><i class="fas fa-lock"></i> {{labels.calendarIntegration_timeOwned}}</p>
        {{else}}
          <div class="form-group">
            <label>{{labels.field_timeSegment}}</label>
            <select name="calendarTimeSegment">
              {{#each timeSegments}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
          <div class="calendar-grid">
            <div class="form-group"><label>{{labels.field_weekday}}</label><select name="calendarWeekday">{{#each weekdays}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
            <div class="form-group"><label>{{labels.field_dayOfMonth}}</label><input type="number" name="calendarDayOfMonth" value="{{calendar.dayOfMonth}}" min="1" max="31"></div>
          </div>
          <div class="calendar-grid">
            <div class="form-group"><label>{{labels.field_month}}</label><select name="calendarMonth">{{#each months}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
            <div class="form-group"><label>{{labels.field_year}}</label><input type="number" name="calendarYear" value="{{calendar.year}}" min="1"></div>
          </div>
          <div class="weather-actions compact">
            <button type="button" data-action="previousTime"><i class="fas fa-chevron-left"></i> {{labels.ui_previousTime}}</button>
            <button type="button" data-action="nextTime">{{labels.ui_nextTime}} <i class="fas fa-chevron-right"></i></button>
            <button type="button" data-action="previousDay"><i class="fas fa-minus"></i> {{labels.ui_previousDay}}</button>
            <button type="button" data-action="nextDay"><i class="fas fa-plus"></i> {{labels.ui_nextDay}}</button>
            <button type="button" data-action="saveCalendar"><i class="fas fa-save"></i> {{labels.ui_saveCalendar}}</button>
          </div>
        {{/if}}
      </article>

      <article class="weather-panel settings-section">
        <h2>{{labels.settingsTab_outputTitle}}</h2>
        <div class="form-group">
          <label>{{labels.forecast_days_label}}</label>
          <select name="forecastDays">
            {{#each appSettings.forecastDays}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label>{{labels.settings_historyLimit_name}}</label>
          <select name="historyLimit">
            {{#each appSettings.historyLimits}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label>{{labels.chat_defaultMode}}</label>
          <select name="chatOutputMode">
            {{#each appSettings.chatModes}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="weather-actions">
          <button type="button" data-action="saveSettings"><i class="fas fa-floppy-disk"></i> {{labels.settingsTab_save}}</button>
        </div>
      </article>
    </section>
  </section>
</form>
