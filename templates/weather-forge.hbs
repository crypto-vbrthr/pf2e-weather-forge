<form class="weather-forge-form">
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-generator" checked>
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-history">
  <input class="weather-tab-input" type="radio" name="weatherForgeTab" id="weather-forge-tab-settings">

  <nav class="weather-tabs" aria-label="{{localize "pf2e-weather-forge.tabs.label"}}">
    <label class="weather-tab" for="weather-forge-tab-generator">
      <i class="fas fa-cloud-sun-rain"></i> {{localize "pf2e-weather-forge.tabs.generator"}}
    </label>
    <label class="weather-tab" for="weather-forge-tab-history">
      <i class="fas fa-book-open"></i> {{localize "pf2e-weather-forge.tabs.history"}}
    </label>
    <label class="weather-tab" for="weather-forge-tab-settings">
      <i class="fas fa-gear"></i> {{localize "pf2e-weather-forge.tabs.settings"}}
    </label>
  </nav>

  <section class="weather-tab-content weather-generator-tab">
    <section class="weather-forge-grid weather-forge-grid-compact">
      <article class="weather-panel current">
        <h2>{{localize "pf2e-weather-forge.ui.currentWeather"}}</h2>
        <div class="weather-card">
          <div class="weather-headline">
            <strong>{{current.timeSegmentLabel}}</strong>
            <span>{{current.seasonLabel}}</span>
          </div>

          <p class="weather-description">{{current.description}}</p>

          <dl class="weather-values">
            <dt>{{localize "pf2e-weather-forge.field.temperature"}}</dt><dd>{{current.temperature}} °C</dd>
            <dt>{{localize "pf2e-weather-forge.field.dailyMinMax"}}</dt><dd>{{current.dailyMinTemp}} / {{current.dailyMaxTemp}} °C</dd>
            <dt>{{localize "pf2e-weather-forge.field.trend"}}</dt><dd>{{current.trendLabel}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.precipitation"}}</dt><dd>{{current.precipitationLabel}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.humidity"}}</dt><dd>{{current.humidity}} % · {{current.humidityDescription}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.cloudDensity"}}</dt><dd>{{current.cloudDensity}} % · {{current.cloudDensityDescription}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.windStrength"}}</dt><dd>{{current.windStrength}} · {{current.windStrengthDescription}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.weekday"}}</dt><dd>{{current.weekdayLabel}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.dayOfMonth"}}</dt><dd>{{current.dayOfMonth}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.month"}}</dt><dd>{{current.monthLabel}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.year"}}</dt><dd>{{current.year}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.moonPhase"}}</dt><dd>{{current.moonPhaseLabel}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.climateZone"}}</dt><dd>{{current.climateZoneLabel}}</dd>
            <dt>{{localize "pf2e-weather-forge.field.extremeWeather"}}</dt><dd>{{current.extremeLabel}}</dd>
          </dl>
        </div>
      </article>

      <article class="weather-panel generation-actions">
        <h2>{{localize "pf2e-weather-forge.ui.weatherGeneration"}}</h2>
        <div class="calendar-summary">
          <strong>{{calendar.weekdayLabel}}, {{calendar.dayOfMonth}}. {{calendar.monthLabel}} {{calendar.year}}</strong><br>
          <span>{{calendar.timeSegmentLabel}} · {{calendar.seasonLabel}} · {{calendar.moonPhaseLabel}}</span>
        </div>

        <p class="weather-hint">{{localize "pf2e-weather-forge.ui.settingsMovedHint"}}</p>

        <div class="weather-actions">
          <button type="button" data-action="generate"><i class="fas fa-dice-d20"></i> {{localize "pf2e-weather-forge.ui.generate"}}</button>
          <button type="button" data-action="accept" {{#unless preview}}disabled{{/unless}}><i class="fas fa-check"></i> {{localize "pf2e-weather-forge.ui.accept"}}</button>
          <button type="button" data-action="reset"><i class="fas fa-undo"></i> {{localize "pf2e-weather-forge.ui.reset"}}</button>
        </div>

        <hr>

        <h3>{{localize "pf2e-weather-forge.chat.publishTitle"}}</h3>
        <div class="weather-actions compact two-buttons">
          <button type="button" data-action="publishGM"><i class="fas fa-user-secret"></i> {{localize "pf2e-weather-forge.chat.publishGM"}}</button>
          <button type="button" data-action="publishPublic"><i class="fas fa-users"></i> {{localize "pf2e-weather-forge.chat.publishPublic"}}</button>
        </div>
      </article>

      <article class="weather-panel preview">
        <h2>{{localize "pf2e-weather-forge.ui.preview"}}</h2>
        {{#if preview}}
          <div class="weather-card">
            <div class="weather-headline">
              <strong>{{preview.timeSegmentLabel}}</strong>
              <span>{{preview.seasonLabel}}</span>
            </div>

            <p class="weather-description">{{preview.description}}</p>

            <dl class="weather-values">
              <dt>{{localize "pf2e-weather-forge.field.temperature"}}</dt><dd>{{preview.temperature}} °C</dd>
              <dt>{{localize "pf2e-weather-forge.field.dailyMinMax"}}</dt><dd>{{preview.dailyMinTemp}} / {{preview.dailyMaxTemp}} °C</dd>
              <dt>{{localize "pf2e-weather-forge.field.trend"}}</dt><dd>{{preview.trendLabel}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.precipitation"}}</dt><dd>{{preview.precipitationLabel}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.humidity"}}</dt><dd>{{preview.humidity}} % · {{preview.humidityDescription}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.cloudDensity"}}</dt><dd>{{preview.cloudDensity}} % · {{preview.cloudDensityDescription}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.windStrength"}}</dt><dd>{{preview.windStrength}} · {{preview.windStrengthDescription}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.weekday"}}</dt><dd>{{preview.weekdayLabel}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.dayOfMonth"}}</dt><dd>{{preview.dayOfMonth}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.month"}}</dt><dd>{{preview.monthLabel}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.year"}}</dt><dd>{{preview.year}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.moonPhase"}}</dt><dd>{{preview.moonPhaseLabel}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.climateZone"}}</dt><dd>{{preview.climateZoneLabel}}</dd>
              <dt>{{localize "pf2e-weather-forge.field.extremeWeather"}}</dt><dd>{{preview.extremeLabel}}</dd>
            </dl>
          </div>
        {{else}}
          <p class="empty-preview">{{localize "pf2e-weather-forge.ui.noPreview"}}</p>
        {{/if}}
      </article>
    </section>
  </section>

  <section class="weather-tab-content weather-history-tab">
    <section class="weather-history-panel">
      <div class="history-header">
        <div>
          <h2>{{localize "pf2e-weather-forge.history.title"}}</h2>
          <p>{{localize "pf2e-weather-forge.history.hint"}}</p>
        </div>
        <button type="button" data-action="clearHistory" {{#unless history.hasEntries}}disabled{{/unless}}>
          <i class="fas fa-trash"></i> {{localize "pf2e-weather-forge.history.clear"}}
        </button>
      </div>

      {{#if history.hasEntries}}
        <div class="history-list">
          {{#each history.groups}}
            <details class="history-day" {{#if @first}}open{{/if}}>
              <summary>
                <span class="history-date">{{weekdayLabel}}, {{dayOfMonth}}. {{monthLabel}} {{year}}</span>
                <span class="history-summary">{{summary}}</span>
              </summary>

              <div class="history-entries">
                {{#each entries}}
                  <article class="history-entry">
                    <div class="history-entry-head">
                      <strong>{{timeSegmentLabel}}</strong>
                      <span>{{temperature}} °C · {{precipitationLabel}}</span>
                    </div>
                    <p class="history-entry-description">{{description}}</p>
                    <dl class="history-entry-values">
                      <dt>{{localize "pf2e-weather-forge.field.dailyMinMax"}}</dt><dd>{{dailyMinTemp}} / {{dailyMaxTemp}} °C</dd>
                      <dt>{{localize "pf2e-weather-forge.field.humidity"}}</dt><dd>{{humidityText}}</dd>
                      <dt>{{localize "pf2e-weather-forge.field.cloudDensity"}}</dt><dd>{{cloudDensityText}}</dd>
                      <dt>{{localize "pf2e-weather-forge.field.windStrength"}}</dt><dd>{{windStrengthText}}</dd>
                      <dt>{{localize "pf2e-weather-forge.field.trend"}}</dt><dd>{{trendLabel}}</dd>
                      <dt>{{localize "pf2e-weather-forge.field.extremeWeather"}}</dt><dd>{{extremeLabel}}</dd>
                    </dl>
                  </article>
                {{/each}}
              </div>
            </details>
          {{/each}}
        </div>
      {{else}}
        <p class="empty-preview">{{localize "pf2e-weather-forge.history.empty"}}</p>
      {{/if}}
    </section>
  </section>

  <section class="weather-tab-content weather-settings-tab">
    <section class="settings-tab-grid">
      <article class="weather-panel settings-section">
        <h2>{{localize "pf2e-weather-forge.settingsTab.climateTitle"}}</h2>
        <div class="form-group">
          <label>{{localize "pf2e-weather-forge.ui.climateZone"}}</label>
          <select name="climateZone">
            {{#each climateZones}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <label class="checkbox-row">
          <input type="checkbox" name="allowExtreme" {{#if appSettings.allowExtreme}}checked{{/if}}>
          <span>{{localize "pf2e-weather-forge.ui.allowExtreme"}}</span>
        </label>

        <label class="checkbox-row">
          <input type="checkbox" name="forceExtreme">
          <span>{{localize "pf2e-weather-forge.ui.forceExtreme"}}</span>
        </label>

        <div class="form-group">
          <label>{{localize "pf2e-weather-forge.ui.extremeType"}}</label>
          <select name="extremeType">
            {{#each extremeTypes}}
              <option value="{{key}}">{{label}}</option>
            {{/each}}
          </select>
        </div>
      </article>

      <article class="weather-panel settings-section">
        <h2>{{localize "pf2e-weather-forge.settingsTab.calendarTitle"}}</h2>
        <div class="calendar-summary">
          <strong>{{calendar.weekdayLabel}}, {{calendar.dayOfMonth}}. {{calendar.monthLabel}} {{calendar.year}}</strong><br>
          <span>{{calendar.timeSegmentLabel}} · {{calendar.seasonLabel}} · {{calendar.moonPhaseLabel}}</span>
        </div>

        <div class="form-group">
          <label>{{localize "pf2e-weather-forge.field.timeSegment"}}</label>
          <select name="calendarTimeSegment">
            {{#each timeSegments}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="calendar-grid">
          <div class="form-group">
            <label>{{localize "pf2e-weather-forge.field.weekday"}}</label>
            <select name="calendarWeekday">
              {{#each weekdays}}
                <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="form-group">
            <label>{{localize "pf2e-weather-forge.field.dayOfMonth"}}</label>
            <input type="number" name="calendarDayOfMonth" value="{{calendar.dayOfMonth}}" min="1" max="31">
          </div>
        </div>

        <div class="calendar-grid">
          <div class="form-group">
            <label>{{localize "pf2e-weather-forge.field.month"}}</label>
            <select name="calendarMonth">
              {{#each months}}
                <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>

          <div class="form-group">
            <label>{{localize "pf2e-weather-forge.field.year"}}</label>
            <input type="number" name="calendarYear" value="{{calendar.year}}" min="1">
          </div>
        </div>

        <div class="weather-actions compact">
          <button type="button" data-action="previousTime"><i class="fas fa-chevron-left"></i> {{localize "pf2e-weather-forge.ui.previousTime"}}</button>
          <button type="button" data-action="nextTime">{{localize "pf2e-weather-forge.ui.nextTime"}} <i class="fas fa-chevron-right"></i></button>
          <button type="button" data-action="previousDay"><i class="fas fa-minus"></i> {{localize "pf2e-weather-forge.ui.previousDay"}}</button>
          <button type="button" data-action="nextDay"><i class="fas fa-plus"></i> {{localize "pf2e-weather-forge.ui.nextDay"}}</button>
          <button type="button" data-action="saveCalendar"><i class="fas fa-save"></i> {{localize "pf2e-weather-forge.ui.saveCalendar"}}</button>
        </div>
      </article>

      <article class="weather-panel settings-section">
        <h2>{{localize "pf2e-weather-forge.settingsTab.outputTitle"}}</h2>
        <div class="form-group">
          <label>{{localize "pf2e-weather-forge.settings.historyLimit.name"}}</label>
          <select name="historyLimit">
            {{#each appSettings.historyLimits}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label>{{localize "pf2e-weather-forge.chat.defaultMode"}}</label>
          <select name="chatOutputMode">
            {{#each appSettings.chatModes}}
              <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="weather-actions">
          <button type="button" data-action="saveSettings"><i class="fas fa-floppy-disk"></i> {{localize "pf2e-weather-forge.settingsTab.save"}}</button>
        </div>
      </article>
    </section>
  </section>
</form>
